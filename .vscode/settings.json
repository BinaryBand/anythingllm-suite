{
  // Python: the uv workspace's one environment, made at the root by `uv run` or `uv sync`.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // pytest reads packages/mcp/pyproject.toml, so it runs from there.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/packages/mcp",
  // The ruff rules in pyproject.toml set line-length 100; the Ruff extension reads them itself.
  "[python]": {
    "editor.rulers": [100]
  },

  // Whitespace, as the files in this repository are kept.
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },

  // Out of the explorer, the search and the file watcher: caches and what the tools generate.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/build": true,
    "**/uv.lock": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true
  }
}
