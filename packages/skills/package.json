{
  "name": "anythingllm-skills",
  "private": true,
  "description": "AnythingLLM agent skills, each built and shipped as its own standalone package",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p shared && tsc -p memory",
    "test": "node build.mjs && node --test \"shared/**/*.test.ts\" \"*/tests/*.test.mts\""
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "imports": {
    "#shared/*": "./shared/*.ts"
  }
}
