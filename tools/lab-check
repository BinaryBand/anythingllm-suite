#!/usr/bin/env bash
# tools/lab-check: the test lab's own checks (tools/lab): every site's flow over HTTP, then the same
# sites in a real Chrome, each page read with the browser skill's own snapshot code from this repo.
# Each starts a lab of its own (ports 4300+ and 4400+, a throwaway database), so the running lab on
# 4100+ isn't touched. Needs Node 22.13 or later; the first run installs the lab's packages, and
# Puppeteer downloads its Chrome (about 150 MB).
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

cd "$ROOT/tools/lab"
[ -d node_modules ] || npm ci --no-audit --no-fund
npm run -s smoke
npm run -s check
