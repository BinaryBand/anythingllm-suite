{
  "about": "A captcha: the login goes in, the user takes over for the digits only",
  "site": "captcha",
  "steps": [
    {
      "say": "@agent sign in to $url"
    },
    {
      "answer": {}
    },
    {
      "user": [
        {
          "tap": [
            0.97,
            0.97
          ]
        },
        {
          "wait": 2
        },
        {
          "field": "empty"
        },
        {
          "type": "$captcha"
        },
        {
          "give": true
        }
      ]
    },
    {
      "say": "Done, I filled in the digits and sent it. Am I signed in, and as who?"
    }
  ],
  "expect": {
    "signedIn": true,
    "asked": [
      {
        "kind": "login"
      }
    ]
  }
}
