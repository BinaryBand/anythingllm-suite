#!/usr/bin/env bash
# tools/e2e: the suite against the real thing. Starts a throwaway AnythingLLM (the image in
# contract/versions.env) on a free port with its storage bind-mounted from a temporary folder, as
# AnythingLLM's Docker instructions do; runs the built `anythingllm-suite install --bridge` into that
# storage, the bridge's `serve` on another free port, makes a developer key and a workspace, and runs
# tools/e2e.test.mts. Everything lives in the temporary folder and a container of its own; both are
# removed on the way out, pass or fail, and nothing running on this machine (an AnythingLLM on
# :3001, a bridge on :8467, the user's settings or service manager) is touched.
#
# The storage must be writable from both sides: with podman the container's user is the host user
# (keep-id); with docker the container makes it world-writable once AnythingLLM has made it.
# Needs podman or docker, curl and Node 22.18 or later; the first run pulls the image.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

engine=$(command -v podman || command -v docker) || { echo "tools/e2e: needs podman or docker" >&2; exit 2; }
podman=$([ "$(basename "$engine")" = podman ] && echo 1 || true)
work=$(mktemp -d)
name="allm-e2e-$$"
bridge_pid=

# open_storage: lets the host user change what the container's user made (docker only).
open_storage() { [ -n "$podman" ] || "$engine" exec -u root "$name" chmod -R a+rwX "$INNER_STORAGE" 2>/dev/null || true; }

cleanup() {
  status=$?
  [ -z "$bridge_pid" ] || kill "$bridge_pid" 2>/dev/null || true
  open_storage
  "$engine" stop -t 1 "$name" >/dev/null 2>&1 || true
  if [ "$status" -ne 0 ] && [ -s "$work/bridge.log" ]; then
    echo "--- the bridge's log" >&2
    tail -n 20 "$work/bridge.log" >&2
  fi
  rm -rf "$work"
  exit "$status"
}
trap cleanup EXIT

# free_port: a port nothing listens on now.
free_port() { node -e 'const s = require("net").createServer().listen(0, "127.0.0.1", () => { console.log(s.address().port); s.close(); });'; }

# json <expression>: reads JSON on stdin as `j` and prints the expression.
json() { node -e "let s = ''; process.stdin.on('data', (d) => (s += d)).on('end', () => { const j = JSON.parse(s); console.log($1); });"; }

# wait_for <url> <what>: up to two minutes for a 200.
wait_for() {
  for _ in $(seq 1 60); do
    curl -fs "$1" >/dev/null 2>&1 && return 0
    sleep 2
  done
  echo "tools/e2e: $2 did not answer at $1" >&2
  return 1
}

allm_port=$(free_port)
bridge_port=$(free_port)
password=$(head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')
allm="http://127.0.0.1:$allm_port"
bridge="http://127.0.0.1:$bridge_port"
storage="$work/storage"
mkdir "$storage"
# The password in the storage's .env, where the bridge reads it, as with AnythingLLM's Docker setup.
printf 'AUTH_TOKEN=%s\n' "$password" >"$storage/.env"
user=()
[ -z "$podman" ] || user=(--userns=keep-id:uid=1000,gid=1000)

echo "[e2e] AnythingLLM ($IMAGE) on :$allm_port, its storage in $storage"
"$engine" run -d --rm --name "$name" -p "127.0.0.1:$allm_port:$INNER_PORT" ${user[@]+"${user[@]}"} \
  -v "$storage:$INNER_STORAGE" -e STORAGE_DIR="$INNER_STORAGE" -e AUTH_TOKEN="$password" \
  -e JWT_SECRET="$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')" "$IMAGE" >/dev/null
wait_for "$allm/api/ping" "AnythingLLM"
open_storage

echo "[e2e] anythingllm-suite install --bridge, built from packages/"
(cd "$ROOT/packages" && node build.mjs bridge >/dev/null)
cli="$ROOT/packages/bridge/dist/anythingllm-suite.cjs"
export BRIDGE_ENV_FILE="$work/bridge.env" BRIDGE_PORT="$bridge_port" ANYTHINGLLM_URL="$allm"
node "$cli" install --storage "$storage" --roles chat,schedule --bridge --no-start >"$work/install.log"

echo "[e2e] the bridge on :$bridge_port"
node "$cli" serve >"$work/bridge.log" 2>&1 &
bridge_pid=$!
wait_for "$bridge/health" "the bridge"

# A developer key, as the settings page makes one, and a workspace for the tests to find.
token=$(curl -fs -X POST "$allm/api/request-token" -H 'Content-Type: application/json' \
  -d "{\"password\":\"$password\"}" | json 'j.token')
key=$(curl -fs -X POST "$allm/api/system/generate-api-key" -H "Authorization: Bearer $token" \
  -H 'Content-Type: application/json' -d '{"name":"e2e"}' | json 'j.apiKey.secret')
workspace=$(curl -fs -X POST "$allm/api/v1/workspace/new" -H "Authorization: Bearer $key" \
  -H 'Content-Type: application/json' -d '{"name":"E2E Workspace"}' | json 'j.workspace.slug')

echo "[e2e] tools/e2e.test.mts"
E2E_ENGINE="$engine" E2E_CONTAINER="$name" E2E_CONTROL="$INNER_STORAGE/anythingllm-suite/control.cjs" E2E_ALLM_URL="$allm" E2E_PASSWORD="$password" \
  E2E_BRIDGE_URL="$bridge" E2E_KEY="$key" E2E_WORKSPACE="$workspace" E2E_CLI="$cli" \
  node --test "$ROOT/tools/e2e.test.mts"
echo "tools/e2e: ok"
