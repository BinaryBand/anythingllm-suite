#!/usr/bin/env bash
# tools/boundaries: fails when the app imports a path into another part. The app talks to the bridge
# over HTTP. Dart has no ast-grep grammar here, so this is grep. The other parts are checked
# elsewhere: the bridge and the skills when they are built (packages/build.mjs fails on a file from
# outside the part), and a Python part cannot import a TypeScript one. Not covered: dynamic imports.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

if [ -d app ] && grep -rEn --include='*.dart' "^[[:space:]]*(import|export)[[:space:]]+['\"](\.\./)+.*(packages|contract|tools)/" app; then
  echo "tools/boundaries: app/ imports a path into another part (above)" >&2
  exit 1
fi
echo "tools/boundaries: ok"
