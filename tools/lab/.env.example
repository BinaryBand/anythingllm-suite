# Copy to .env; npm start reads it.

# Where the sites listen. 0.0.0.0 lets AnythingLLM in Docker reach them (host.docker.internal).
LAB_BIND=127.0.0.1
# The dashboard (with the outbox of codes) stays on localhost unless you change this.
LAB_DASHBOARD_BIND=127.0.0.1
# The dashboard's port; the sites take the next seventeen.
LAB_BASE_PORT=4100
# Each site's address behind the tunnel, for the dashboard's links. {name} is the site's name.
# LAB_PUBLIC_URL=https://lab-{name}.example.com
# Signs the session cookies. Unset: a random one kept in data/secret.
# LAB_SECRET=
# The database file. Unset: data/lab.db.
# LAB_DB=

# How long a sign-in approval on Meridian Wallet waits for the Phone panel, in seconds.
# LAB_PUSH_TTL=60
# How long a confirmation on Stratus Console lasts before the next sensitive step asks again, in seconds.
# LAB_SUDO_SECONDS=120
# The shortest time Fortress Bank's human check takes to pass, in milliseconds.
# LAB_GATE_MIN_MS=1000
# How long a Murmur Chat sign-in lasts before the session ends by itself, in seconds.
# LAB_MURMUR_SESSION_SECONDS=600
