{
  "name": "test-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Fake sites with sign-up and login, for testing the AnythingLLM browser skill",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "smoke": "node --disable-warning=ExperimentalWarning test/smoke.mjs",
    "reset": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/reset.js",
    "check": "node --disable-warning=ExperimentalWarning test/build-snapshot.mjs && node --disable-warning=ExperimentalWarning test/check.mjs",
    "check:snapshot": "node test/build-snapshot.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^4.22.3",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer": "^24.43.1"
  }
}
